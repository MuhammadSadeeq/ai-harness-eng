{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Board (docs/ENGINE.md section 7)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "label": {
      "type": "string",
      "pattern": "^[\\x20-\\x7e\\n\\t]*$"
    },
    "modules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "turn_limit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_turns": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "max_turns"
          ]
        },
        "token_budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_tokens": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "max_tokens"
          ]
        },
        "loop_detect": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "window": {
              "type": "integer",
              "minimum": 2
            }
          },
          "required": [
            "window"
          ]
        },
        "output_cap": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_tokens": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "max_tokens"
          ]
        },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_attempts": {
              "type": "integer",
              "minimum": 1
            },
            "base_ms": {
              "type": "integer",
              "minimum": 0
            },
            "cap_ms": {
              "type": "integer",
              "minimum": 0
            },
            "jitter": {
              "enum": [
                "none",
                "full"
              ]
            }
          },
          "required": [
            "max_attempts",
            "base_ms",
            "cap_ms",
            "jitter"
          ]
        },
        "breaker": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "threshold": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "threshold"
          ]
        },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "allow",
                "ask",
                "deny"
              ]
            },
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "decision": {
                    "enum": [
                      "allow",
                      "ask",
                      "deny"
                    ]
                  },
                  "tool": {
                    "type": "string",
                    "minLength": 1
                  },
                  "match": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^[\\x20-\\x7e\\n\\t]*$"
                    },
                    "additionalProperties": {
                      "type": "string",
                      "pattern": "^[\\x20-\\x7e\\n\\t]*$"
                    }
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[\\x20-\\x7e\\n\\t]*$"
                  }
                },
                "required": [
                  "decision",
                  "tool",
                  "reason"
                ]
              }
            }
          },
          "required": [
            "mode"
          ]
        },
        "sandbox": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "egress": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[\\x20-\\x7e\\n\\t]*$",
                "not": {
                  "pattern": "[A-Z]"
                }
              }
            }
          }
        },
        "verify_gate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_feedback": {
              "type": "integer",
              "minimum": 0
            },
            "pristine_tests": {
              "type": "boolean"
            }
          },
          "required": [
            "max_feedback"
          ]
        },
        "close_books": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        },
        "rules_file": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rules": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "redact": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "patterns": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[\\x20-\\x7e\\n\\t]*$"
              }
            }
          },
          "required": [
            "patterns"
          ]
        },
        "history": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "resend": {
              "type": "boolean"
            }
          },
          "required": [
            "resend"
          ]
        },
        "first_block_only": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        },
        "compaction": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "threshold_percent": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "keep": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "goal",
                  "constraint",
                  "decision",
                  "progress",
                  "file"
                ]
              }
            }
          },
          "required": [
            "threshold_percent",
            "keep"
          ]
        },
        "system_clock": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        },
        "cache": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        },
        "validate_inputs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        },
        "split_results": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        },
        "effort": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "level": {
              "enum": [
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ]
            }
          },
          "required": [
            "level"
          ]
        },
        "tool_overrides": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[\\x20-\\x7e\\n\\t]*$"
              },
              "input_schema": {
                "type": "object"
              }
            }
          }
        },
        "tool_search": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "always": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "always"
          ]
        },
        "cost_attribution": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        },
        "tool_pins": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pins"
          ],
          "properties": {
            "pins": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "subagents": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "context": {
              "enum": [
                "isolated",
                "forked"
              ]
            },
            "max": {
              "type": "integer",
              "minimum": 1
            },
            "max_turns": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "context",
            "max",
            "max_turns"
          ]
        },
        "progress_file": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "path"
          ]
        },
        "durable_session": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        },
        "tool_retry": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_attempts": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "max_attempts"
          ]
        },
        "idempotency": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id"
          ]
        },
        "request_params": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "integer"
            ]
          }
        },
        "capability_check": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        }
      }
    }
  },
  "required": [
    "id",
    "label",
    "modules"
  ]
}
