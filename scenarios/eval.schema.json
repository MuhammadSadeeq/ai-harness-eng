{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HARNESSED eval (ENGINE.md A11.7, A12.3)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema",
    "title",
    "kind",
    "tasks",
    "trials",
    "boards"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "schema": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[\\x20-\\x7e\\n\\t]*$"
    },
    "kind": {
      "enum": [
        "capability",
        "regression"
      ]
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "tape"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[\\x20-\\x7e\\n\\t]*$"
          },
          "tape": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        }
      }
    },
    "trials": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "boards": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "seed_base": {
      "type": "integer",
      "minimum": 0
    },
    "model_grader": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "false_pass_percent",
        "false_fail_percent"
      ],
      "properties": {
        "false_pass_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "false_fail_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    }
  }
}
