{
  "schema": 1,
  "title": "Tools loaded on demand",
  "task": "Find a lint tool and use it.",
  "model_id": "claude-sonnet-5-5",
  "pricing": {
    "input_milli_per_mtok": 1000,
    "output_milli_per_mtok": 2000,
    "cache_write_milli_per_mtok": 1250,
    "cache_read_milli_per_mtok": 100
  },
  "window": 8000,
  "system": "You are a coding agent. Use the tools you are given.",
  "rules": [],
  "workspace": {
    "calc.py": "def add(a, b):\n    return a - b\n"
  },
  "outside": {},
  "tools": [
    "read_file",
    "list_files"
  ],
  "custom_tools": [
    {
      "name": "lint_file",
      "description": "Lint a Python file for style problems.",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      },
      "latency_ms": 100,
      "results": [],
      "default": {
        "output": "No style problems.",
        "ok": true
      }
    },
    {
      "name": "format_file",
      "description": "Format a Python file in place.",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      },
      "latency_ms": 100,
      "results": [],
      "default": {
        "output": "Formatted.",
        "ok": true
      }
    },
    {
      "name": "count_lines",
      "description": "Count the lines in a file.",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      },
      "latency_ms": 100,
      "results": [],
      "default": {
        "output": "7 lines",
        "ok": true
      }
    }
  ],
  "checks": [
    {
      "file": "calc.py",
      "not_contains": "pass"
    }
  ],
  "test_output": {
    "pass": "1 passed",
    "fail": "1 failed"
  },
  "human": {
    "default": "approve"
  },
  "interrupt": null,
  "seed_base": 20261010,
  "golden_seeds": [
    0,
    1,
    2
  ],
  "id": "eng-search",
  "script": [
    {
      "say": "Searching for a lint tool.",
      "tools": [
        [
          "tool_search",
          {
            "query": "lint python"
          }
        ]
      ]
    },
    {
      "when": [
        {
          "if": "tool_loaded:lint_file",
          "then": [
            {
              "say": "lint_file is in the request.",
              "tools": [
                [
                  "tool_search",
                  {
                    "query": "bake cake"
                  }
                ]
              ]
            }
          ]
        },
        {
          "else": [
            {
              "say": "lint_file is not in the request.",
              "tools": [
                [
                  "tool_search",
                  {
                    "query": "bake cake"
                  }
                ]
              ]
            }
          ]
        }
      ]
    },
    {
      "say": "Nothing matched. I'll count the lines anyway.",
      "tools": [
        [
          "count_lines",
          {
            "path": "calc.py"
          }
        ]
      ]
    },
    {
      "when": [
        {
          "if": "tools_gte:4",
          "then": [
            {
              "say": "Four or more tools are in the request.",
              "tools": [
                [
                  "count_lines",
                  {
                    "path": "calc.py"
                  }
                ]
              ]
            }
          ]
        },
        {
          "else": [
            {
              "say": "Fewer than four tools are in the request.",
              "tools": [
                [
                  "count_lines",
                  {
                    "path": "calc.py"
                  }
                ]
              ]
            }
          ]
        }
      ]
    },
    {
      "when": [
        {
          "if": "tool_loaded:count_lines",
          "then": [
            {
              "say": "count_lines is in the request."
            }
          ]
        },
        {
          "else": [
            {
              "say": "count_lines was never sent."
            }
          ]
        }
      ]
    }
  ],
  "boards": [
    "eng-search-on",
    "eng-search-off"
  ]
}
