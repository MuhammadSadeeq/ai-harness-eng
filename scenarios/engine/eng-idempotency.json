{
  "schema": 1,
  "model_id": "claude-sonnet-5-5",
  "pricing": {
    "input_milli_per_mtok": 1000,
    "output_milli_per_mtok": 2000,
    "cache_write_milli_per_mtok": 1250,
    "cache_read_milli_per_mtok": 100
  },
  "window": 8000,
  "system": "You are a coding agent. Use the tools you are given.",
  "rules": [],
  "outside": {},
  "tools": [
    "read_file",
    "write_file"
  ],
  "custom_tools": [
    {
      "name": "pay",
      "description": "Pay a person an amount in whole units.",
      "input_schema": {
        "type": "object",
        "properties": {
          "to": {
            "type": "string"
          },
          "amount": {
            "type": "integer"
          }
        },
        "required": [
          "to",
          "amount"
        ],
        "additionalProperties": false
      },
      "latency_ms": 200,
      "trifecta": [],
      "ledger": "payments.txt",
      "lose_reply": [
        1
      ],
      "results": [],
      "default": {
        "output": "Paid.",
        "ok": true
      }
    }
  ],
  "human": {
    "default": "approve"
  },
  "interrupt": null,
  "test_output": {
    "pass": "1 passed",
    "fail": "1 failed"
  },
  "seed_base": 20261010,
  "golden_seeds": [
    0,
    1,
    2
  ],
  "id": "eng-idempotency",
  "title": "A payment whose reply is lost, retried with and without keys",
  "task": "Pay Sam ten, then say whether the payment went through.",
  "workspace": {
    "payments.txt": ""
  },
  "checks": [
    {
      "file": "payments.txt",
      "lines": 1
    }
  ],
  "script": [
    {
      "say": "I'll pay Sam ten.",
      "tools": [
        [
          "pay",
          {
            "to": "sam",
            "amount": 10
          }
        ]
      ]
    },
    {
      "when": [
        {
          "if": "last_result_contains:Paid",
          "then": [
            {
              "say": "Paid. Done.",
              "stop": "end_turn"
            }
          ]
        },
        {
          "else": [
            {
              "say": "The payment did not confirm, so I stop.",
              "stop": "end_turn"
            }
          ]
        }
      ]
    }
  ],
  "boards": [
    "eng-idem-retry",
    "eng-idem-both"
  ]
}
