{
  "schema": 1,
  "model_id": "claude-sonnet-5-5",
  "pricing": {
    "input_milli_per_mtok": 1000,
    "output_milli_per_mtok": 2000,
    "cache_write_milli_per_mtok": 1250,
    "cache_read_milli_per_mtok": 100
  },
  "window": 8000,
  "system": "You are a coding agent. Use the tools you are given.",
  "rules": [],
  "outside": {},
  "tools": [
    "read_file",
    "write_file"
  ],
  "custom_tools": [],
  "human": {
    "default": "approve"
  },
  "interrupt": null,
  "test_output": {
    "pass": "1 passed",
    "fail": "1 failed"
  },
  "seed_base": 20261010,
  "golden_seeds": [
    0,
    1,
    2
  ],
  "id": "eng-sessions",
  "title": "Three sessions, the third reads a progress note",
  "task": "Read the two notes across sessions and write summary.txt.",
  "workspace": {
    "notes/a.txt": "Buy milk.\n",
    "notes/b.txt": "Call Sam.\n"
  },
  "checks": [
    {
      "file": "summary.txt",
      "contains": "Two notes"
    }
  ],
  "sessions": [
    {
      "script": [
        {
          "say": "I'll read the first note and keep a progress note.",
          "tools": [
            [
              "read_file",
              {
                "path": "notes/a.txt"
              }
            ]
          ]
        },
        {
          "say": "Saving the progress note.",
          "tools": [
            [
              "write_file",
              {
                "path": "progress.md",
                "content": "Read a.txt. Next: read b.txt.\n"
              }
            ]
          ]
        },
        {
          "say": "Session one is done.",
          "stop": "end_turn"
        }
      ]
    },
    {
      "script": [
        {
          "say": "Reading the second note.",
          "tools": [
            [
              "read_file",
              {
                "path": "notes/b.txt"
              }
            ]
          ]
        },
        {
          "say": "Session two is done.",
          "stop": "end_turn"
        }
      ]
    },
    {
      "script": [
        {
          "when": [
            {
              "if": "session_gte:3",
              "then": [
                {
                  "when": [
                    {
                      "if": "sent_lacks:Next: read b.txt",
                      "then": [
                        {
                          "say": "The progress note is missing, so I write the summary from the notes.",
                          "tools": [
                            [
                              "write_file",
                              {
                                "path": "summary.txt",
                                "content": "Two notes.\n"
                              }
                            ]
                          ]
                        }
                      ]
                    },
                    {
                      "else": [
                        {
                          "say": "The note says b.txt was next. I write the summary.",
                          "tools": [
                            [
                              "write_file",
                              {
                                "path": "summary.txt",
                                "content": "Two notes.\n"
                              }
                            ]
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "else": [
                {
                  "say": "This is not the third session."
                }
              ]
            }
          ]
        },
        {
          "say": "Done.",
          "stop": "end_turn"
        }
      ]
    }
  ],
  "boards": [
    "eng-sessions-plain",
    "eng-sessions-progress"
  ]
}
