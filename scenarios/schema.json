{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scenario tape (docs/ENGINE.md section 5 and 6)",
  "description": "Integers only; ASCII only; checked again by rein.tape at load time.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "schema": {
      "const": 1
    },
    "title": {
      "type": "string",
      "pattern": "^[\\x20-\\x7e\\n\\t]*$"
    },
    "task": {
      "type": "string",
      "pattern": "^[\\x20-\\x7e\\n\\t]*$"
    },
    "model_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[\\x20-\\x7e\\n\\t]*$"
    },
    "pricing": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fact": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[\\x20-\\x7e\\n\\t]*$"
            }
          },
          "required": [
            "fact"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "input_milli_per_mtok": {
              "type": "integer",
              "minimum": 0
            },
            "output_milli_per_mtok": {
              "type": "integer",
              "minimum": 0
            },
            "cache_write_milli_per_mtok": {
              "type": "integer",
              "minimum": 0
            },
            "cache_read_milli_per_mtok": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "input_milli_per_mtok",
            "output_milli_per_mtok"
          ]
        }
      ]
    },
    "window": {
      "type": "integer",
      "minimum": 1
    },
    "system": {
      "type": "string",
      "pattern": "^[\\x20-\\x7e\\n\\t]*$"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[\\x20-\\x7e\\n\\t]*$"
      }
    },
    "workspace": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[\\x20-\\x7e\\n\\t]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^[\\x20-\\x7e\\n\\t]*$"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "link": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[\\x20-\\x7e\\n\\t]*$"
              }
            },
            "required": [
              "link"
            ]
          }
        ]
      }
    },
    "outside": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[\\x20-\\x7e\\n\\t]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^[\\x20-\\x7e\\n\\t]*$"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "link": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[\\x20-\\x7e\\n\\t]*$"
              }
            },
            "required": [
              "link"
            ]
          }
        ]
      }
    },
    "tools": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "read_file",
          "write_file",
          "edit_file",
          "list_files",
          "run_command"
        ]
      }
    },
    "custom_tools": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/custom_tool"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[\\x20-\\x7e\\n\\t]*$"
              },
              "contains": {
                "type": "string",
                "pattern": "^[\\x20-\\x7e\\n\\t]*$"
              }
            },
            "required": [
              "file",
              "contains"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[\\x20-\\x7e\\n\\t]*$"
              },
              "not_contains": {
                "type": "string",
                "pattern": "^[\\x20-\\x7e\\n\\t]*$"
              }
            },
            "required": [
              "file",
              "not_contains"
            ]
          }
        ]
      }
    },
    "test_output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pass": {
          "type": "string",
          "pattern": "^[\\x20-\\x7e\\n\\t]*$"
        },
        "fail": {
          "type": "string",
          "pattern": "^[\\x20-\\x7e\\n\\t]*$"
        }
      },
      "required": [
        "pass",
        "fail"
      ]
    },
    "script": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "human": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": {
          "enum": [
            "approve",
            "deny"
          ]
        },
        "deny_if": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "pattern": "^[\\x20-\\x7e\\n\\t]*$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[\\x20-\\x7e\\n\\t]*$"
          }
        },
        "fatigue": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "after": {
              "type": "integer",
              "minimum": 0
            },
            "approve_percent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "after",
            "approve_percent"
          ]
        }
      },
      "required": [
        "default"
      ]
    },
    "interrupt": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "turn": {
              "type": "integer",
              "minimum": 1
            },
            "resume": {
              "type": "boolean"
            }
          },
          "required": [
            "turn"
          ]
        }
      ]
    },
    "boards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "golden_seeds": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "seed_base": {
      "type": "integer",
      "minimum": 0
    },
    "incident": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "wire",
        "board",
        "seed",
        "first_bad_seq",
        "why",
        "hint",
        "fixes",
        "correct_fix",
        "par_s"
      ],
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[\\x20-\\x7e\\n\\t]*$"
        },
        "wire": {
          "enum": [
            "control",
            "context",
            "loop",
            "errors",
            "tools",
            "permissions",
            "verify",
            "observe"
          ]
        },
        "board": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[\\x20-\\x7e\\n\\t]*$"
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "first_bad_seq": {
          "type": "integer",
          "minimum": 0
        },
        "accept_seqs": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "default": []
        },
        "why": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[\\x20-\\x7e\\n\\t]*$"
        },
        "hint": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[\\x20-\\x7e\\n\\t]*$"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "seq",
              "text"
            ],
            "properties": {
              "seq": {
                "type": "integer",
                "minimum": 0
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[\\x20-\\x7e\\n\\t]*$"
              }
            }
          }
        },
        "fixes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "why"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[\\x20-\\x7e\\n\\t]*$"
              },
              "why": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[\\x20-\\x7e\\n\\t]*$"
              }
            }
          }
        },
        "correct_fix": {
          "type": "integer",
          "minimum": 0
        },
        "par_s": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "faults": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "percent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "type": {
            "enum": [
              "overloaded",
              "rate_limit",
              "api_error",
              "timeout",
              "invalid_request"
            ]
          }
        },
        "required": [
          "percent",
          "type"
        ]
      }
    },
    "outage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from_ms": {
          "type": "integer",
          "minimum": 0
        },
        "to_ms": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "enum": [
            "overloaded",
            "rate_limit",
            "api_error",
            "timeout",
            "invalid_request"
          ]
        },
        "retry_after_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "from_ms",
        "to_ms",
        "type"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[\\x20-\\x7e\\n\\t]*$"
          },
          "kind": {
            "enum": [
              "goal",
              "constraint",
              "decision",
              "progress",
              "file"
            ]
          },
          "turn": {
            "type": "integer",
            "minimum": 0
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[\\x20-\\x7e\\n\\t]*$"
          }
        },
        "required": [
          "id",
          "kind",
          "turn",
          "text"
        ]
      }
    },
    "cache_rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "ttl_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "min_tokens",
        "ttl_ms"
      ]
    },
    "effort": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": {
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        },
        "thinking_tokens": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "low": {
              "type": "integer",
              "minimum": 0
            },
            "medium": {
              "type": "integer",
              "minimum": 0
            },
            "high": {
              "type": "integer",
              "minimum": 0
            },
            "xhigh": {
              "type": "integer",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[\\x20-\\x7e\\n\\t]*$"
          },
          "marker": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[\\x20-\\x7e\\n\\t]*$"
              },
              "contains": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[\\x20-\\x7e\\n\\t]*$"
              }
            },
            "required": [
              "file",
              "contains"
            ]
          },
          "check": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "file": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[\\x20-\\x7e\\n\\t]*$"
                  },
                  "contains": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[\\x20-\\x7e\\n\\t]*$"
                  }
                },
                "required": [
                  "file",
                  "contains"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "file": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[\\x20-\\x7e\\n\\t]*$"
                  },
                  "not_contains": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[\\x20-\\x7e\\n\\t]*$"
                  }
                },
                "required": [
                  "file",
                  "not_contains"
                ]
              }
            ]
          }
        },
        "required": [
          "id",
          "marker",
          "check"
        ]
      }
    },
    "canaries": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[\\x20-\\x7e\\n\\t]*$"
      },
      "description": "A11.3: secret strings the tape plants in workspace or outside."
    }
  },
  "required": [
    "id",
    "schema",
    "title",
    "task",
    "model_id",
    "pricing",
    "window",
    "system",
    "workspace",
    "outside",
    "tools",
    "custom_tools",
    "checks",
    "test_output",
    "script",
    "boards",
    "golden_seeds"
  ],
  "$defs": {
    "step": {
      "oneOf": [
        {
          "$ref": "#/$defs/reply"
        },
        {
          "$ref": "#/$defs/error"
        },
        {
          "$ref": "#/$defs/branch"
        },
        {
          "$ref": "#/$defs/when"
        },
        {
          "$ref": "#/$defs/repeat"
        }
      ]
    },
    "reply": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "say": {
          "type": "string",
          "pattern": "^[\\x20-\\x7e\\n\\t]*$"
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^[\\x20-\\x7e\\n\\t]*$"
              },
              {
                "type": "object"
              }
            ],
            "items": false
          }
        },
        "stop": {
          "enum": [
            "end_turn",
            "tool_use",
            "max_tokens",
            "refusal"
          ]
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "stop"
            ],
            "properties": {
              "stop": {
                "const": "tool_use"
              }
            }
          },
          "then": {
            "required": [
              "tools"
            ],
            "properties": {
              "tools": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "tools"
            ],
            "properties": {
              "tools": {
                "minItems": 1
              }
            }
          },
          "then": {
            "properties": {
              "stop": {
                "const": "tool_use"
              }
            }
          }
        }
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "error": {
          "enum": [
            "overloaded",
            "rate_limit",
            "api_error",
            "timeout",
            "invalid_request"
          ]
        },
        "retry_after_ms": {
          "type": "integer",
          "minimum": 0
        },
        "error_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "error"
      ]
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "branch": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "percent": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "then": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/step"
                }
              }
            },
            "required": [
              "percent",
              "then"
            ]
          }
        }
      },
      "required": [
        "branch"
      ]
    },
    "when": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "when": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "if": {
                    "$ref": "#/$defs/condition"
                  },
                  "then": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/step"
                    }
                  }
                },
                "required": [
                  "if",
                  "then"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "else": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/step"
                    }
                  }
                },
                "required": [
                  "else"
                ]
              }
            ]
          }
        }
      },
      "required": [
        "when"
      ]
    },
    "repeat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repeat": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/step"
              }
            },
            "times": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "const": "forever"
                }
              ]
            }
          },
          "required": [
            "steps",
            "times"
          ]
        }
      },
      "required": [
        "repeat"
      ]
    },
    "condition": {
      "oneOf": [
        {
          "enum": [
            "last_result_error",
            "last_denied",
            "verify_feedback",
            "last_truncated",
            "results_split"
          ]
        },
        {
          "type": "string",
          "pattern": "^turn_gte:(0|[1-9][0-9]*)$"
        },
        {
          "type": "string",
          "pattern": "^history_lt:(0|[1-9][0-9]*)$"
        },
        {
          "type": "string",
          "pattern": "^context_gte:(0|[1-9][0-9]*)$"
        },
        {
          "type": "string",
          "pattern": "^sent_lacks:.+$"
        },
        {
          "type": "string",
          "pattern": "^effort_gte:(low|medium|high|xhigh|max)$"
        },
        {
          "type": "string",
          "pattern": "^tools_gte:(0|[1-9][0-9]*)$"
        },
        {
          "type": "string",
          "pattern": "^tool_loaded:.+$"
        },
        {
          "type": "string",
          "pattern": "^last_result_contains:.+$"
        }
      ]
    },
    "custom_tool": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]*$"
        },
        "description": {
          "type": "string",
          "pattern": "^[\\x20-\\x7e\\n\\t]*$"
        },
        "input_schema": {
          "type": "object"
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0
        },
        "effect": {
          "enum": [
            "network"
          ]
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "match": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "integer",
                    "boolean",
                    "null"
                  ]
                }
              },
              "output": {
                "type": "string",
                "pattern": "^[\\x20-\\x7e\\n\\t]*$"
              },
              "ok": {
                "type": "boolean"
              }
            },
            "required": [
              "match",
              "output"
            ]
          }
        },
        "default": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "output": {
              "type": "string",
              "pattern": "^[\\x20-\\x7e\\n\\t]*$"
            },
            "ok": {
              "type": "boolean"
            }
          },
          "required": [
            "output"
          ]
        },
        "server": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[\\x20-\\x7e\\n\\t]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[\\x20-\\x7e\\n\\t]*$"
        },
        "trifecta": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "private_data",
              "untrusted_content",
              "exfiltration"
            ]
          }
        }
      },
      "required": [
        "name",
        "description",
        "input_schema",
        "results"
      ]
    }
  }
}
