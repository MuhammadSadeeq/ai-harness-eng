  "seed_base": 20261010,
  "boards": [
    "c8-old",
    "c8-new"
  ],
  "incident": {
    "family": "tool-overload",
    "wire": "tools",
    "board": "c8-old",
    "seed": 0,
    "first_bad_seq": 5,
    "accept_seqs": [
      1,
      7
    ],
    "why": "The request on turn 1 sends all sixteen tool definitions (write_file and fifteen tools) (seq 1). The reply then picks ticket_list, one of the look-alikes, and the lookup never runs (seq 5). Sixteen definitions in every call make the wrong pick easy, and each call pays for all of them.",
    "hint": "Count the tools in the request on turn 1. Then read the tool the reply picks. Is it the one the task needs?",
    "notes": [
      {
        "seq": 1,
        "text": "The request is ordinary; the harness sends what it was given. The question is whether every definition belongs in every call."
      },
      {
        "seq": 7,
        "text": "The error tells the model where to go: ticket_lookup. Tempting: blame the error. The pick was already wrong before the error came back."
      },
      {
        "seq": 13,
        "text": "The run stops and says done. The lookup failed, so the run ends without the answer."
      }
    ],
    "fixes": [
      {
        "text": "Load each tool only when a step needs it, with a keyword search over the definitions",
        "why": "The request carries the few tools the step needs, so the look-alikes are not offered, and each call pays for fewer definitions."
      },
      {
        "text": "Use a bigger model, which can choose among more tools",
        "why": "Tempting and wrong: a bigger model still sees the same sixteen definitions, and each call still pays for all of them."
      },
      {
        "text": "Delete the look-alike tools",
        "why": "Tempting and wrong: the other tools are real and the team uses them. Remove them from this run, not from the course."
      }
    ],
    "correct_fix": 0,
    "par_s": 60
  }
}
