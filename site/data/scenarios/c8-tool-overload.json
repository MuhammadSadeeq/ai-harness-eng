  "script": [
    {
      "when": [
        {
          "if": "tools_gte:10",
          "then": [
            {
              "branch": [
                {
                  "percent": 50,
                  "then": [
                    {
                      "say": "I'll list the open tickets for the customer.",
                      "tools": [
                        [
                          "ticket_list",
                          {
                            "customer": "acme"
                          }
                        ]
                      ],
                      "stop": "tool_use"
                    }
                  ]
                },
                {
                  "percent": 50,
                  "then": [
                    {
                      "say": "I'll look up the ticket.",
                      "tools": [
                        [
                          "ticket_lookup",
                          {
                            "id": "T-204"
                          }
                        ]
                      ],
                      "stop": "tool_use"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "else": [
            {
              "say": "The lookup tool is not loaded. I'll search for it.",
              "tools": [
                [
                  "tool_search",
                  {
                    "query": "ticket lookup"
                  }
                ]
              ],
              "stop": "tool_use"
            },
            {
              "when": [
                {
                  "if": "tool_loaded:ticket_lookup",
                  "then": [
                    {
                      "say": "Looking up the ticket.",
                      "tools": [
                        [
                          "ticket_lookup",
                          {
                            "id": "T-204"
                          }
                        ]
                      ],
                      "stop": "tool_use"
                    }
                  ]
                },
                {
                  "else": [
                    {
                      "say": "The lookup tool did not load, so I can't give the status. Stopping here.",
                      "stop": "end_turn"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "when": [
        {
          "if": "last_result_error",
          "then": [
            {
              "say": "The lookup failed, so I can't give the status. Stopping here.",
              "stop": "end_turn"
            }
          ]
        }
      ]
    },
    {
      "say": "T-204 is open. Writing it down.",
      "tools": [
        [
          "write_file",
          {
            "path": "answer.txt",
            "content": "T-204 is open\n"
          }
        ]
      ],
      "stop": "tool_use"
    },
    {
      "say": "Done. T-204 is open."
    }
  ],
  "human": {
    "default": "approve"
  },
  "interrupt": null,
  "golden_seeds": [
    0,
