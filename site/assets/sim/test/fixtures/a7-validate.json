{
  "schema": 1,
  "title": "A7 fixture",
  "model_id": "claude-sonnet-5-5",
  "pricing": {
    "input_milli_per_mtok": 2000,
    "output_milli_per_mtok": 10000
  },
  "window": 8000,
  "system": "You are a coding agent. Use the tools to change files and run tests. Say done when the tests pass.",
  "rules": [],
  "workspace": {
    "a.txt": "hello\n",
    "b.txt": "world\n"
  },
  "outside": {},
  "checks": [],
  "test_output": {
    "pass": "ok",
    "fail": "nope"
  },
  "human": {
    "default": "approve"
  },
  "interrupt": null,
  "faults": [],
  "outage": null,
  "seed_base": 20261010,
  "id": "a7-validate",
  "task": "Count the lines in a.txt.",
  "tools": [
    "read_file"
  ],
  "custom_tools": [
    {
      "name": "count_lines",
      "description": "Count the lines of a file.",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "lines",
              "words"
            ]
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      },
      "results": [
        {
          "match": {
            "path": "a.txt"
          },
          "output": "1 line"
        }
      ]
    }
  ],
  "script": [
    {
      "say": "Reading the file.",
      "tools": [
        [
          "read_file",
          {}
        ]
      ]
    },
    {
      "say": "Counting.",
      "tools": [
        [
          "count_lines",
          {
            "path": "a.txt",
            "mode": "bytes"
          }
        ]
      ]
    },
    {
      "say": "Reading it properly.",
      "tools": [
        [
          "read_file",
          {
            "path": "a.txt"
          }
        ]
      ]
    },
    {
      "say": "All done.",
      "stop": "end_turn"
    }
  ]
}
