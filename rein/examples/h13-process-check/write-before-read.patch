+def wrote_before_read(events: list[dict[str, Any]]) -> bool:
+    """H13 extension (process check): a write_file of a path the run had not read first (ok calls only).
+
+    edit_file is not counted: its old text must match the file, which already guards the edit.
+    """
+    read: set[str] = set()
+    for event in events:
+        if event.get("kind") != "tool_call" or event.get("ok") is not True:
+            continue
+        path = (event.get("input") or {}).get("path")
+        if not isinstance(path, str):
+            continue
+        if event.get("tool") == "read_file":
+            read.add(path)
+        elif event.get("tool") == "write_file" and path not in read:
+            return True
+    return False
+
